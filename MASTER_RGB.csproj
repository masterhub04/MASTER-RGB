<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>MASTER HUB</AssemblyName>
    <RootNamespace>MasterRgb</RootNamespace>
    <Version>0.9.11</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\\master-rgb.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Maintenance/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="System.Management" Version="8.0.0" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="YellowDogMan.RRNoise.NET" Version="0.1.9" />
    <PackageReference Include="Velopack" Version="1.2.161" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets\\master-rgb.ico" />
    <Content Include="HTML/index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>