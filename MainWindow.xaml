<Window x:Class="MasterRgb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MASTER RGB v0.8.6" Icon="Assets/master-rgb.ico" Height="820" Width="1320"
        MinHeight="700" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="245"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="#0D1723" BorderBrush="#203448" BorderThickness="0,0,1,0">
            <DockPanel Margin="18">
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="2,8,0,28">
                        <Border Width="42" Height="42" CornerRadius="12" Background="#12364D">
                            <TextBlock Text="⚡" FontSize="24" Foreground="#35C8FF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="MASTER RGB" FontSize="20" FontWeight="Bold"/>
                            <TextBlock Text="UNIVERSAL LIGHTING" FontSize="9" Foreground="{StaticResource MutedBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="#6F8CA3" FontSize="10" FontWeight="Bold" Margin="8,0,0,10"/>
                    <Button Content="▦   Dashboard" HorizontalContentAlignment="Left" Background="#17364D"/>
                    <Button Content="✦   Lighting Studio" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="▣   Devices" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent"/>
                    <Button Content="▤   Profiles" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent"/>
                    <TextBlock Text="SYSTEM" Foreground="#6F8CA3" FontSize="10" FontWeight="Bold" Margin="8,28,0,10"/>
                    <Button Content="⚙   Settings" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent"/>
                    <Button x:Name="UpdatesButton" Content="↻   Verificar atualização" HorizontalContentAlignment="Left" Background="Transparent" BorderBrush="Transparent" Click="CheckUpdates_Click"/>
                    <TextBlock x:Name="CurrentVersionText" Text="Versão 0.8.6" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="30,0,0,4"/>
                    <TextBlock Text="APARÊNCIA" Foreground="#6F8CA3" FontSize="10" FontWeight="Bold" Margin="8,28,0,10"/>
                    <TextBlock Text="Escolha seu tema" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="8,0,0,8"/>
                    <UniformGrid Columns="1">
                        <Button x:Name="BlueThemeButton" Content="●   Azul elétrico" HorizontalContentAlignment="Left" Click="BlueTheme_Click" Margin="0,2,0,2"/>
                        <Button x:Name="LightThemeButton" Content="○   Claro" HorizontalContentAlignment="Left" Click="LightTheme_Click" Margin="0,2,0,2"/>
                        <Button x:Name="DarkThemeButton" Content="○   Escuro" HorizontalContentAlignment="Left" Click="DarkTheme_Click" Margin="0,2,0,2"/>
                    </UniformGrid>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#111F2E" CornerRadius="10" Padding="12" Margin="0,20,0,0">
                    <StackPanel>
                        <TextBlock Text="ENGINE STATUS" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold"/>
                        <TextBlock x:Name="EngineStatusText" Text="Aguardando conexão" Margin="0,7,0,0" FontWeight="SemiBold"/>
                        <TextBlock Text="OpenRGB SDK • localhost:6742" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Main content -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="30,25,30,30">
                <Grid Margin="0,0,0,24">
                    <StackPanel>
                        <TextBlock Text="Dashboard" FontSize="28" FontWeight="Bold"/>
                        <TextBlock Text="Central de controle da iluminação do seu PC" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Background="#123B2B" CornerRadius="12" Padding="10,6" Margin="0,0,10,0">
                            <TextBlock Text="●  LOCAL" Foreground="#5CE0A1" FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="v0.8.4" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Background="#102338" BorderBrush="#1D4A68" BorderThickness="1" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="WELCOME TO MASTER RGB" Foreground="#52CFFF" FontSize="10" FontWeight="Bold"/>
                            <TextBlock Text="Sua iluminação. Um só lugar." FontSize="23" FontWeight="Bold" Margin="0,8,0,5"/>
                            <TextBlock Text="Controle de cores estáticas por dispositivo e zona, usando o OpenRGB SDK." Foreground="#A8C1D3" TextWrapping="Wrap" MaxWidth="650"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="ConnectOpenRgbButton" Content="Conectar ao OpenRGB" Click="ConnectOpenRgb_Click" Margin="0,0,8,0"/>
                            <Button x:Name="RunDiagnosticButton" Content="▤  Diagnóstico completo" Background="#17435A" Click="RunDiagnostic_Click"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <TextBlock Text="HARDWARE" FontSize="11" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,8,0,12"/>
                <Border Background="{StaticResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,0,0,22">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Dispositivos encontrados" FontWeight="SemiBold" FontSize="15"/>
                            <TextBlock x:Name="DeviceCountText" Text="Ainda não lido" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </Grid>
                        <ItemsControl x:Name="DeviceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111F2E" CornerRadius="9" Padding="12" Margin="0,4,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14"/>
                                                <TextBlock Text="{Binding Details}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding ZonesText}" Foreground="#55CFFF" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Background="#123B2B" CornerRadius="8" Padding="9,5" VerticalAlignment="Center" Margin="12,0,0,0">
                                                <TextBlock Text="{Binding Status}" Foreground="#5CE0A1" FontSize="9" FontWeight="Bold"/>
                                            </Border>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="EmptyDevicesText" Text="Clique em Conectar ao OpenRGB para ler os dispositivos reais." Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <TextBlock Text="LIGHTING STUDIO" FontSize="11" Foreground="#7F9BB0" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="Controle estático • aplicação por zona" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/>
                </Grid>
                <Border Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="20" Margin="0,0,0,18">
                    <StackPanel>
                        <TextBlock Text="Controle de iluminação" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Escolha um dispositivo e uma zona. A cor será aplicada somente à zona selecionada." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,16"/>
                        <TextBlock Text="APLICAÇÃO EM GRUPO" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,0,0,7"/>
                        <Border Background="#111F2E" CornerRadius="9" Padding="10" Margin="0,0,0,14">
                            <StackPanel>
                                <DockPanel LastChildFill="False" Margin="0,0,0,7">
                                    <TextBlock Text="Marque os dispositivos que receberão a mesma cor em todas as zonas." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Width="470"/>
                                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                                        <Button Content="Selecionar todos" Click="SelectAllDevices_Click" Padding="9,5" Margin="0,0,6,0"/>
                                        <Button Content="Limpar" Click="ClearDeviceSelection_Click" Padding="9,5"/>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl x:Name="MultiDeviceList">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <CheckBox Content="{Binding Name}" Tag="{Binding Index}" IsChecked="{Binding IsSelected, Mode=TwoWay}" Foreground="{StaticResource TextBrush}" Margin="0,3,18,3"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock x:Name="MultiSelectInfo" Text="Nenhum dispositivo selecionado para aplicação em grupo." Foreground="#55CFFF" FontSize="10" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Border>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock Text="DISPOSITIVO" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="DeviceSelector" DisplayMemberPath="Name" SelectionChanged="DeviceSelector_SelectionChanged" MinHeight="38"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="ZONA" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ComboBox x:Name="ZoneSelector" DisplayMemberPath="DisplayName" SelectionChanged="ZoneSelector_SelectionChanged" MinHeight="38"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="QUANTIDADE DE LEDS DA ZONA" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="ZoneLedCountBox" Text="0" VerticalContentAlignment="Center" FontSize="15" MaxLength="5"/>
                            <TextBlock x:Name="ZoneLedCountInfo" Grid.Column="1" Text="Quantidade detectada pelo OpenRGB" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </Grid>
                        <TextBlock Text="COR PERSONALIZADA" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,18,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border x:Name="ColorPreview" Background="#35C8FF" CornerRadius="8" Height="42" Margin="0,0,10,0" BorderBrush="#36536A" BorderThickness="1"/>
                            <TextBox x:Name="HexColorBox" Grid.Column="1" Text="#35C8FF" VerticalContentAlignment="Center" FontSize="16" MaxLength="7" TextChanged="HexColorBox_TextChanged" ToolTip="Digite a cor no formato #RRGGBB"/>
                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Content="Aplicar cor" Click="ApplyColor_Click" MinWidth="112"/>
                                <Button Content="Aplicar aos selecionados" Click="ApplyToSelectedDevices_Click" MinWidth="170" Margin="7,0,0,0" Background="#17435A"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="SELETOR DE CORES" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,14,0,6"/>
                        <Border Background="#111F2E" CornerRadius="10" Padding="10" HorizontalAlignment="Left">
                            <Canvas x:Name="HueArcCanvas" Width="360" Height="190" Background="Transparent" Loaded="HueArcCanvas_Loaded" MouseLeftButtonDown="HueArcCanvas_MouseLeftButtonDown"/>
                        </Border>
                        <TextBlock Text="Clique no arco para escolher uma tonalidade. Use o brilho abaixo para ajustar a intensidade." Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        <TextBlock Text="AJUSTE FINO RGB" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,14,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <TextBlock Text="R" Foreground="#FF7777" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="53" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="CustomColorSlider_ValueChanged"/>
                            <TextBlock x:Name="RedValueText" Grid.Column="2" Text="53" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <TextBlock Text="G" Foreground="#65E69A" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="200" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="CustomColorSlider_ValueChanged"/>
                            <TextBlock x:Name="GreenValueText" Grid.Column="2" Text="200" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
                            <TextBlock Text="B" Foreground="#72BFFF" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="255" TickFrequency="1" IsSnapToTickEnabled="False" ValueChanged="CustomColorSlider_ValueChanged"/>
                            <TextBlock x:Name="BlueValueText" Grid.Column="2" Text="255" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="BRILHO DOS LEDS" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,16,0,5"/>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/></Grid.ColumnDefinitions>
                            <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="5" ValueChanged="BrightnessSlider_ValueChanged" VerticalAlignment="Center"/>
                            <TextBlock x:Name="BrightnessValueText" Grid.Column="1" Text="100%" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock Text="O brilho é aplicado reduzindo a intensidade da cor enviada à zona selecionada." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,2,0,0"/>
                        <TextBlock Text="CORES RÁPIDAS" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,18,0,8"/>
                        <UniformGrid Columns="8">
                            <Button Content="" Background="#FF3434" Height="30" Margin="0,0,7,0" Tag="#FF3434" Click="QuickColor_Click"/>
                            <Button Content="" Background="#FF8A32" Height="30" Margin="0,0,7,0" Tag="#FF8A32" Click="QuickColor_Click"/>
                            <Button Content="" Background="#FFD84A" Height="30" Margin="0,0,7,0" Tag="#FFD84A" Click="QuickColor_Click"/>
                            <Button Content="" Background="#31D98A" Height="30" Margin="0,0,7,0" Tag="#31D98A" Click="QuickColor_Click"/>
                            <Button Content="" Background="#35C8FF" Height="30" Margin="0,0,7,0" Tag="#35C8FF" Click="QuickColor_Click"/>
                            <Button Content="" Background="#496BFF" Height="30" Margin="0,0,7,0" Tag="#496BFF" Click="QuickColor_Click"/>
                            <Button Content="" Background="#A05BFF" Height="30" Margin="0,0,7,0" Tag="#A05BFF" Click="QuickColor_Click"/>
                            <Button Content="" Background="#F5F8FF" Height="30" Tag="#F5F8FF" Click="QuickColor_Click"/>
                        </UniformGrid>
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Content="★  Salvar cor favorita" Click="AddFavorite_Click" Background="#17435A" MinWidth="170"/>
                            <Button Grid.Column="1" Content="Desligar zona (preto)" HorizontalAlignment="Left" Margin="10,0,0,0" Background="#26394A" Click="TurnOffZone_Click"/>
                        </Grid>
                        <TextBlock Text="MINHAS CORES FAVORITAS" FontSize="10" Foreground="#7F9BB0" FontWeight="Bold" Margin="0,18,0,8"/>
                        <ItemsControl x:Name="FavoriteColorsList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#111F2E" CornerRadius="8" Padding="5" Margin="0,0,8,8" BorderBrush="#29445A" BorderThickness="1">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="" Width="24" Height="24" Padding="0" Margin="0,0,6,0" Background="{Binding Brush}" Tag="{Binding Hex}" Click="QuickColor_Click" ToolTip="Selecionar esta cor"/>
                                            <TextBlock Text="{Binding Hex}" VerticalAlignment="Center" FontSize="11" Margin="0,0,5,0"/>
                                            <Button Content="×" Width="22" Height="22" Padding="0" Background="#26394A" Tag="{Binding Hex}" Click="RemoveFavorite_Click" ToolTip="Remover favorita"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Background="#111F2E" CornerRadius="12" Padding="14" Margin="0,18,0,0">
                    <StackPanel>
                        <TextBlock Text="DIAGNÓSTICO E ATUALIZAÇÕES" FontWeight="Bold" FontSize="11" Foreground="#7F9BB0"/>
                        <TextBlock Text="O diagnóstico é somente leitura: coleta dados do SDK e dos controladores, sem alterar cores ou modos." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="StatusText" Text="Pronto. Conecte ao OpenRGB SDK Server para ler os dispositivos." TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock x:Name="UpdateText" Text="Atualizações: configure o endereço do repositório GitHub em Settings.json." Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
